    {
      "cell_type": "code",
      "source": [
        "from sklearn.model_selection import cross_val_predict\n",
        "from sklearn.calibration import calibration_curve\n",
        "from sklearn.metrics import brier_score_loss\n",
        "\n",
        "# Out-of-fold predicted probabilities of passing (primary population)\n",
        "oof = {\n",
        "    \"Logistic Regression\": cross_val_predict(make_logreg(), X, y, cv=cv, method=\"predict_proba\")[:, 1],\n",
        "    \"Random Forest\": cross_val_predict(make_rf(), X, y, cv=cv, method=\"predict_proba\")[:, 1],\n",
        "}\n",
        "\n",
        "# Brier score: mean squared error of the probabilities (lower is better)\n",
        "base_rate = y.mean()\n",
        "brier_baseline = brier_score_loss(y, np.full(len(y), base_rate))\n",
        "print(f\"Baseline Brier (always predict {base_rate:.3f}): {brier_baseline:.3f}\")\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(6, 6))\n",
        "ax.plot([0, 1], [0, 1], \"k--\", label=\"Perfect calibration\")\n",
        "\n",
        "for name, prob in oof.items():\n",
        "    brier = brier_score_loss(y, prob)\n",
        "    print(f\"{name}: Brier = {brier:.3f}\")\n",
        "    frac_pass, mean_pred = calibration_curve(y, prob, n_bins=5, strategy=\"quantile\")\n",
        "    ax.plot(mean_pred, frac_pass, marker=\"o\", label=f\"{name} (Brier {brier:.3f})\")\n",
        "\n",
        "ax.set_xlabel(\"Predicted probability of passing\")\n",
        "ax.set_ylabel(\"Observed share who passed\")\n",
        "ax.set_title(\"Calibration (out-of-fold, 5 bins)\")\n",
        "ax.legend()\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"calibration.png\", dpi=150, bbox_inches=\"tight\")\n",
        "plt.show()"
      ],
